# Closing Client System — account-level defaults
# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is gitignored — it never gets shared or committed.
# Leave anything blank if you don't have it yet. Nothing here is required to start;
# skills will ask you for whatever's missing when they actually need it.

# --- AI Ark (optional — only needed for the advanced/beta API auto-export mode) ---
# Default flow doesn't need this: you export the CSV yourself from AI Ark's UI.
AI_ARK_API_KEY=

# --- Your email sequencer ---
# Only fill in the section for whichever tool you actually use (set during
# onboarding — see the "Sequencer" line in agency-profile.md). Leave the
# others blank.

# PlusVibe: if you run every client out of one account with separate
# workspaces, set your API key here and override PLUSVIBE_WORKSPACE_ID per
# client in clients/<name>/credentials.env instead of repeating the key everywhere.
PLUSVIBE_API_KEY=
PLUSVIBE_WORKSPACE_ID=

# SmartLead
SMARTLEAD_API_KEY=

# Email Bison
EMAILBISON_API_KEY=

# Instantly (API v2 — key is workspace-scoped, no separate workspace ID needed)
INSTANTLY_API_KEY=

# --- Jina AI (optional — only needed if you turn on the lead enrichment scraper) ---
# Works without a key at low volume; add one for higher rate limits.
# Get one free at https://jina.ai/reader
JINA_API_KEY=
